msgstr "jak dlouho čekat na odpověď"

msgid "timeout"
msgstr "čas"


### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "ve výchozím nastavení se používají pouze ICMP časovou značku (viz str. 16 normy RFC792)"

msgid "use IP timestamp and ICMP echo"
msgstr "použije časovou značku IP a ICMP echo"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "použije třízáznamovou časovou značku IP a ICMP echo"

msgid "by default, 'ctime' format is used"
msgstr "ve výchozím nastavení se používá formát 'ctime'"

msgid "use ISO time format"
msgstr "použije časový formát ISO"


### ping options

msgid "use audible ping"
msgstr "použije slyšitelný ping"

msgid "use adaptive ping"
msgstr "použije adaptivní ping"

msgid "sticky source address"
msgstr "trvalá zdrojová adresa"

msgid "stop after 'count' replies"
msgstr "skončí po 'počet' odpovědích"

msgid "call connect() syscall on socket creation"
msgstr "použije connect() syscall při on tvorbě soketu"

msgid "use SO_DEBUG socket option"
msgstr "použije SO_DEBUG volbu soketu"

msgid "print timestamps"
msgstr "vypíše časovou značku"

msgid "define ident for ping session, default is random for"
msgstr "definuje identifikátor pro ping session, výchozí je náhodný pro"

msgid "SOCK_RAW and kernel defined for SOCK_DGRAM,"
msgstr "SOCK_RAW a definován kernelem pro SOCK_DGRAM,"

msgid "imply using SOCK_RAW (for IPv4 only for ident 0)"
msgstr "zahrnuje použití SOCK_RAW (pro IPv4 jen pro identifikátor 0)"

msgid "flood ping"
msgstr "zahlcující ping"

msgid "force reverse DNS name resolution, override -n"
msgstr "vynutí překlad reverzního DNS doménového jména, přebije -n"

msgid "(useful for numeric destinations or for -f)"
msgstr "(vhodné pro numerické cíle nebo pro -f)"

msgid "seconds between sending each packet"
msgstr "sekundy mezi odesláním jednotlivých paketů"

msgid "either interface name or address"
msgstr "rozhraní nebo adresa packetů"

msgid "send 'preload' number of packages while waiting replies"
msgstr "pošle 'přednačítání' paketů během čekání na odpovědi"

msgid "suppress loopback of multicast packets"
msgstr "potlačí příjem vlastních multicastových dotazů"

msgid "tag the packets going out"
msgstr "označí odchozí pakety"

msgid "define path MTU discovery, can be one of do|dont|want|probe"
msgstr "definuje volbu pro PMTU discovery, jedno z do|dont|want|probe"

msgid "no reverse DNS name resolution, override -H"
msgstr "nepřeloží doménová jména, přebije -H"

msgid "report outstanding replies"
msgstr "nahlásí nevyřízené odpovědi"

msgid "content of padding bytes"
msgstr "obsah výplňových bajtů"

msgid "quality of service bits (ToS IPv4, TClass IPv6)"
msgstr "bity kvality služby (ToS IPv4, TClass IPv6)"

msgid "payload size"
msgstr "velikost payloadu"

msgid "use 'size' as SO_SNDBUF socket option value"
msgstr "použije 'velikost' jako hodnotu SO_SNDBUF volbu soketu"

msgid "define 'ttl' (time to live)"
msgstr "definuje dobu životnosti (ttl)"

msgid "print user-to-user latency"
msgstr "vypíše uživatel-uživatel latenci"

msgid "reply wait 'deadline' in seconds"
msgstr "čekání na odpověď v sekundách"

msgid "time to wait for response"
msgstr "časoví limit pro odpovědi"

msgid "IPv4 options"
msgstr "IPv4 volby"

msgid "allow broadcast pings"
msgstr "povolí všesměrový pingy"

msgid "record route"
msgstr "zaznamenat routování"

msgid "define timestamp, can be one of TSONLY|TSANDADDR|TSPRESPEC"
msgstr "definuje časovou značku, jedno z TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "IPv6 volby"

msgid "define flow label, default is random"
msgstr "definuje jmenovku toku, výchozí je náhodná"

msgid "use IPv6 node info query, try 'help' as argument, details in ping(8)"
msgstr "použije IPv6 node info query, try 'help' as argument, podrobnosti v ping(8)"


