msgstr "kolik paketů se má odeslat"

msgid "count"
msgstr "počet"

msgid "duplicate address detection mode"
msgstr "režim zjišťování duplicitních adres"

msgid "quit on first reply"
msgstr "skončí s první odpovědí"

