msgstr "დროის შტამპის აღწერა. შეიძლება იყოს ერთ-ერთი სიიდან TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "IPv6 პარამეტრები"

msgid "define flow label, default is random"
msgstr "დინების ჭდის გამოყენება. ნაგულისხმები მნიშვნელობა შემთხვევითია"

