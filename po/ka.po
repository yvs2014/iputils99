### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "ნაგულისხმევად გამოიყენება მხოლოდ ICMP დროის ნიშნული (იხ RFC792, გვ 16)"

msgid "use IP timestamp and ICMP echo"
msgstr "IP დროის შტამპისა და icmp ექოს გამოყენება"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "3 IP დროის შტამპისა და icmp ექოს გამოყენება"

msgid "by default, 'ctime' format is used"
msgstr "ნაგულისხმევად გამოიყენება ctime ფორმატი"

msgid "use ISO time format"
msgstr "გამოიყენეთ ISO დროის ფორმატი"


### ping options

msgid "use audible ping"
msgstr "audible ping-ის გამოყენება"

msgid "use adaptive ping"
msgstr "adaptive ping-ის გამოყენება"

msgid "sticky source address"
msgstr "წებოვანი წყაროს მისამართი"

msgid "stop after 'count' replies"
msgstr "შეჩერება მითითებული რაოდენობის მქონე პასუხების შემდეგ"

msgid "call connect() syscall on socket creation"
