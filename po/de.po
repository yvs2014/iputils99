### arping options

msgid "ARP answer mode, update your neighbours"
msgstr "ARP Antwort-Modus, Nachbarn aktualisieren"

msgid "keep on broadcasting, do not unicast"
msgstr "Alle Pakete als Broadcast versenden, kein Unicast verwenden"

msgid "how many packets to send"
msgstr "Anzahl Pakete senden"

msgid "count"
msgstr "Anzahl"

msgid "duplicate address detection mode"
msgstr "Modus zur Erkennung doppelter Adressen (DAD)"

msgid "quit on first reply"
msgstr "Nach erster Antwort beenden"

msgid "set interval between packets (default: 1 second)"
msgstr "Paket-Sendeintervall (Standard: 1 Sekunde)"

