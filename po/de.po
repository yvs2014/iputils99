msgstr "Time-out"


### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "Standardmäßig werden nur ICMP-Zeitstempel verwendet (siehe RFC792, Seite 16)"

msgid "use IP timestamp and ICMP echo"
msgstr "IP-Zeitstempel und ICMP-Echo verwenden"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "Dreimaligen IP-Zeitstempel und ICMP-Echo verwenden"

msgid "by default, 'ctime' format is used"
msgstr "Standardmäßig wird das ctime-Format verwendet"

msgid "use ISO time format"
msgstr "ISO-Zeitformat verwenden"


### ping options

msgid "use audible ping"
msgstr "Verwende akustischen Ping"

msgid "use adaptive ping"
msgstr "Verwende adaptiven Ping"

msgid "sticky source address"
msgstr "Sticky Quell-Adresse"

msgid "stop after 'count' replies"
msgstr "Stoppe nach 'Anzahl' Antworten"

msgid "call connect() syscall on socket creation"
msgstr "Rufe connect() syscall bei der Erstellung des Sockets auf"

msgid "use SO_DEBUG socket option"
msgstr "Verwende die SO_DEBUG Socket-Option"

msgid "print timestamps"
msgstr "Gebe Zeitstempel aus"

msgid "define ident for ping session, default is random for"
msgstr "Lege die Kennung für die Ping Session fest, der Standard ist Zufall für"

msgid "SOCK_RAW and kernel defined for SOCK_DGRAM,"
msgstr "SOCK_RAW und Kernel-definiert für SOCK_DGRAM,"

msgid "imply using SOCK_RAW (for IPv4 only for ident 0)"
msgstr "Impliziert die Verwendung von SOCK_RAW (für IPv4 gibt es nur die Kennung 0)"

msgid "flood ping"
msgstr "Flutender Ping"

msgid "force reverse DNS name resolution, override -n"
msgstr "Erzwinge Rückwerts-DNS-Namenauflösung, überschreibt -n"

msgid "(useful for numeric destinations or for -f)"
msgstr "(nützlich für numerische Ziele oder bei -f)"

msgid "seconds between sending each packet"
msgstr "Sekunden zwischen dem Senden jedes Pakets"

msgid "either interface name or address"
msgstr "Entweder Schnittstellennamen oder Adresse"

msgid "send 'preload' number of packages while waiting replies"
msgstr "Sendet 'Nutzlast' Anzahl der Pakete während auf"

msgid "suppress loopback of multicast packets"
msgstr "Unterdrückt Loopback für Multicast-Pakete"

msgid "tag the packets going out"
msgstr "Markiere ausgehende Pakete"

msgid "define path MTU discovery, can be one of do|dont|want|probe"
msgstr "Definiert den path MTU discovery Modus, kann einer der folgenden sein do|dont|want|probe"

msgid "no reverse DNS name resolution, override -H"
msgstr "Keine Rückwerts-DNS-Namenauflösung, überschreibt -H"

msgid "report outstanding replies"
msgstr "Berichte über ausstehende Antworten"

msgid "content of padding bytes"
msgstr "Inhalt der Füllbytes"

msgid "quality of service bits (ToS IPv4, TClass IPv6)"
msgstr "Quality-of-Service-Bits (ToS IPv4, TClass IPv6)"

msgid "payload size"
msgstr "Nutzdatengröße"

msgid "use 'size' as SO_SNDBUF socket option value"
msgstr "Verwende <Größe> als Wert der Socket-Option SO_SNDBUF"

msgid "define 'ttl' (time to live)"
msgstr "Lege die Zeit zum Leben (TTL) fest"

msgid "print user-to-user latency"
msgstr "Gebe die Benutzer-zu-Benutzer Latenz aus"

msgid "reply wait 'deadline' in seconds"
msgstr "Warte 'Deadline' Sekunden auf Antwort"

msgid "time to wait for response"
msgstr "Wartezeit auf Antwort"

msgid "IPv4 options"
msgstr "IPv4-Optionen"

msgid "allow broadcast pings"
msgstr "Erlaube Broadcast-Pings"

msgid "record route"
msgstr "Zeichne Route"

msgid "define timestamp, can be one of TSONLY|TSANDADDR|TSPRESPEC"
msgstr "Legt den Zeitstempel fest, kann eines der folgenden sein TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "IPv6-Optionen"

msgid "define flow label, default is random"
msgstr "Lege das flow-label fest, Standard ist ein Zufälliges"

msgid "use IPv6 node info query, try 'help' as argument, details in ping(8)"
msgstr "Verwende IPv6 Node-Info-Anfrage, versuche <Hilfe> als Argument, Details in ping(8)"


