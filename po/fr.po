### arping options

msgid "ARP answer mode, update your neighbours"
msgstr "mode réponse ARP, met à jour vos voisins"

msgid "keep on broadcasting, do not unicast"
msgstr "continuer à diffuser, ne pas diffuser en monodiffusion"

msgid "how many packets to send"
msgstr "nombre de paquets à envoyer"

msgid "count"
msgstr "nombre"

msgid "duplicate address detection mode"
msgstr "mode de détection d’adresses dupliquées"

msgid "quit on first reply"
msgstr "quitter dès la première réponse"

msgid "set interval between packets (default: 1 second)"
msgstr "définir l’intervalle entre les paquets (par défaut : 1 seconde)"

msgid "interval"
msgstr "num"

