msgstr "temps"


### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "par défaut, seul le timestamp ICMP est utilisé (voir RFC792, page 16)"

msgid "use IP timestamp and ICMP echo"
msgstr "utiliser le timestamp IP et ICMP echo"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "utiliser le timestamp IP three-term et ICMP echo"

msgid "by default, 'ctime' format is used"
msgstr "par défaut, le format 'ctime' est utilisé"

msgid "use ISO time format"
msgstr "utiliser le format d'heure ISO"


### ping options

msgid "use audible ping"
msgstr "utiliser un ping sonore"

msgid "use adaptive ping"
msgstr "utiliser un ping adaptatif"

msgid "sticky source address"
msgstr "adresse source persistante"

msgid "stop after 'count' replies"
msgstr "s'arrête après 'count' réponses"

msgid "call connect() syscall on socket creation"
msgstr "appelle l'appel système connect() lors de la création d'un socket"

msgid "use SO_DEBUG socket option"
msgstr "utiliser l'option de socket SO_DEBUG"

msgid "print timestamps"
msgstr "imprimer les timestamp"

msgid "define ident for ping session,"
msgstr "définit l'identifiant de la session ping,"

msgid "default is random for SOCK_RAW and kernel defined for SOCK_DGRAM,"
msgstr "la valeur par défaut est aléatoire pour SOCK_RAW et noyau définis pour SOCK_DGRAM,"

msgid "imply using SOCK_RAW (for IPv4 only for ident 0)"
msgstr "impliquer l'utilisation de SOCK_RAW (pour IPv4 uniquement pour l'identifiant 0)"

msgid "flood ping"
msgstr "ping d'inondation"

msgid "force reverse DNS name resolution, override -n"
msgstr "force la résolution inversée du nom DNS, remplacer -n"

msgid "(useful for numeric destinations or for -f)"
msgstr "(utile pour les destinations ou pour -f)"

msgid "seconds between sending each packet"
msgstr "secondes entre l'envoi de chaque paquet"

msgid "either interface name or address"
msgstr "soit le nom ou l'adresse de l'interface"

msgid "send 'preload' number of packages while waiting replies"
msgstr "envoie 'précharge' paquets en attendant les réponses"

msgid "suppress loopback of multicast packets"
msgstr "supprime le bouclage des paquets multicast"

msgid "tag the packets going out"
msgstr "marque les paquets sortants"

msgid "define path MTU discovery, can be one of do|dont|want|probe"
msgstr "définit le chemin de découverte MTU, peut être l'un des do|dont|want|probe"

msgid "no reverse DNS name resolution, override -H"
msgstr "pas de résolution de nom DNS inversée, remplacez -H"

msgid "report outstanding replies"
msgstr "signaler les réponses en attente"

msgid "content of padding bytes"
msgstr "contenu des octets de remplissage"

msgid "quality of service bits (ToS IPv4, TClass IPv6)"
msgstr "bits de qualité de service (ToS IPv4, TClass IPv6)"

msgid "payload size"
msgstr "la taille de la charge utile"

msgid "use 'size' as SO_SNDBUF socket option value"
msgstr "utilise 'taille' comme valeur d'option de socket SO_SNDBUF"

msgid "define 'ttl' (time to live)"
msgstr "définit la durée de vie (TTL)"

msgid "print user-to-user latency"
msgstr "imprimer la latence d'utilisateur à utilisateur"

msgid "reply wait 'deadline' in seconds"
msgstr "la réponse attend 'échéance' en secondes"

msgid "time to wait for response"
msgstr "temps d'attente pour la réponse"

msgid "IPv4 options"
msgstr "Options IPv4"

msgid "allow broadcast pings"
msgstr "autoriser la diffusion du ping"

msgid "record route"
msgstr "enregistrer route"

msgid "define timestamp, can be one of TSONLY|TSANDADDR|TSPRESPEC"
msgstr "définit le timestamp, peut être l'un des TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "Options IPv6"

msgid "define flow label, default is random"
msgstr "définit l'étiquette du flux, la valeur par défaut est aléatoire"

msgid "use IPv6 node info query, try '-N help', details in ping(8)"
msgstr "utilise la requête d'informations sur le nœud IPv6, essayez '-N help', détails dans ping(8)"

