### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "varsayılan olarak yalnızca ICMP zaman damgası kullanılır (bkz: RFC792, sayfa 16)"

msgid "use IP timestamp and ICMP echo"
msgstr "IP zaman damgası ve ICMP yankı kullan"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "üç bileşenli IP zaman damgası ve ICMP yankı kullan"

msgid "by default, 'ctime' format is used"
msgstr "varsayılan olarak 'ctime' biçimi kullanılır"

msgid "use ISO time format"
msgstr "ISO zaman formatını kullanın"


### ping options

msgid "use audible ping"
msgstr "duyulabilir ping kullan"

msgid "use adaptive ping"
msgstr "uyarlanabilir ping kullan"

msgid "sticky source address"
msgstr "yapışkan kaynak adresi"

msgid "stop after 'count' replies"
msgstr "'sayı' yanıttan sonra dur"

msgid "call connect() syscall on socket creation"
msgstr "soket oluştururken connect() sistem çağrısını kullan"

msgid "use SO_DEBUG socket option"
msgstr "SO_DEBUG soket seçeneğini kullan"

msgid "print timestamps"
msgstr "zaman damgalarını yazdır"

msgid "define ident for ping session,"
msgstr "ping oturumu için tanımlayıcı belirt,"

msgid "default is random for SOCK_RAW and kernel defined for SOCK_DGRAM,"
msgstr "öntanımlı SOCK_RAW için rastgele ve SOCK_DGRAM için çekirdek tarafından tanımlıdır"

msgid "imply using SOCK_RAW (for IPv4 only for ident 0)"
msgstr "SOCK_RAW kullanıldığını varsayar (IPv4 için yalnızca 0 tanımlayıcısı için)"

msgid "flood ping"
msgstr "ping flood"

msgid "force reverse DNS name resolution, override -n"
msgstr "ters DNS ad çözümlemesini zorla, -n seçeneğini geçersiz kıl"

msgid "(useful for numeric destinations or for -f)"
msgstr "(sayısal hedefler veya -f için kullanışlıdır)"

msgid "seconds between sending each packet"
msgstr "her paketin gönderilmesi arasında geçen saniye"

msgid "either interface name or address"
msgstr "arayüz adı veya adresi"

msgid "send 'preload' number of packages while waiting replies"
msgstr "yanıt beklerken 'ön-yükleme' tane paket gönder"

msgid "suppress loopback of multicast packets"
msgstr "çok noktaya yayın paketlerinin geri döngüsünü engelle"

