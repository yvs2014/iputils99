msgstr "mtu keşfi tanımla, do|dont|want|probe seçeneklerinden biri olabilir"

msgid "no reverse DNS name resolution, override -H"
msgstr "DNS ad çözümlemesi yapılmasın, -H seçeneğini geçersiz kıl"

msgid "report outstanding replies"
msgstr "bekleyen yanıtları bildir"

msgid "content of padding bytes"
msgstr "dolgu baytlarının içeriği"

