msgstr "hizmet kalitesi bitleri (ToS IPv4, TClass IPv6)"

msgid "payload size"
msgstr "veri yükü boyutu"

msgid "use 'size' as SO_SNDBUF socket option value"
msgstr "SO_SNDBUF soket seçeneği değeri olarak 'boyut' kullan"

msgid "define 'ttl' (time to live)"
msgstr "yaşam süresini belirt (TTL)"

msgid "print user-to-user latency"
msgstr "kullanıcıdan kullanıcıya gecikmeyi yazdır"

msgid "reply wait 'deadline' in seconds"
msgstr "son tarihten önce yanıt için bekleme süresi (saniye cinsinden)"

msgid "time to wait for response"
msgstr "yanıt için beklenecek süre"

msgid "IPv4 options"
msgstr "IPv4 seçenekleri"

msgid "allow broadcast pings"
msgstr "genel yayın pinglemeye izin ver"

msgid "record route"
msgstr "rotayı kaydet"

msgid "define timestamp, can be one of TSONLY|TSANDADDR|TSPRESPEC"
msgstr "zaman damgasını belirt, TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "IPv6 seçenekleri"

msgid "define flow label, default is random"
msgstr "akış etiketini belir, öntanımlı olarak rastgeledir"

