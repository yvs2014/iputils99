### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "por padrão, são usados apenas os timestamps de ICMP (consulte RFC792, página 16)"

msgid "use IP timestamp and ICMP echo"
msgstr "usa carimbo de tempo IP e eco de iCMP"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "usa carimbo de tempo IP e eco de ICMP em três termos"

msgid "by default, 'ctime' format is used"
msgstr "por padrão, formato 'ctime' é utilizado"

msgid "use ISO time format"
msgstr "usa formato de hora ISO"


### ping options

msgid "use audible ping"
msgstr "usar ping audível"

msgid "use adaptive ping"
msgstr "usar ping adaptativo"

msgid "sticky source address"
msgstr "endereço de origem fixo"

msgid "stop after 'count' replies"
msgstr "parar após 'contagem' respostas"

