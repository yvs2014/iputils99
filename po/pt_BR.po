msgstr "enviar 'pré-carga' número de pacotes enquanto aguarda respostas"

msgid "suppress loopback of multicast packets"
msgstr "suprimir loopback de pacotes multicast"

msgid "tag the packets going out"
msgstr "etiquetar os pacotes que saem"

