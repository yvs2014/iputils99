msgstr "chamar a chamada de sistema connect() na criação do soquete"

msgid "use SO_DEBUG socket option"
msgstr "usar opção de soquete SO_DEBUG"

msgid "print timestamps"
msgstr "imprimir timestamps"

msgid "define ident for ping session,"
msgstr "definir identificador para sessão de ping,"

