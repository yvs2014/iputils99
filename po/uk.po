### arping options

msgid "ARP answer mode, update your neighbours"
msgstr "режим відповідей ARP, оновити ваше оточення"

msgid "keep on broadcasting, do not unicast"
msgstr "надалі бродкастити, не переходити до направленої адресації"

msgid "how many packets to send"
msgstr "кількість пакетів, які слід надіслати"

msgid "count"
msgstr "число"

msgid "duplicate address detection mode"
msgstr "режим виявлення дублікатів адрес"

msgid "quit on first reply"
msgstr "вийти при першій відповіді"

msgid "set interval between packets (default: 1 second)"
msgstr "інтервал між пакетами (типове значення: 1 секунда)"

msgid "interval"
msgstr "інтервал"

msgid "which ethernet device to use"
msgstr "пристрій ethernet, яким слід скористатися"

msgid "device"
msgstr "пристрій"

msgid "source IP address"
msgstr "IP адреса джерела"

msgid "source"
msgstr "джерело"

msgid "unsolicited ARP mode, update your neighbours"
msgstr "режим ARP без запитів, оновити ваше оточення"

msgid "how long to wait for a reply"
msgstr "час очікування на відповідь"

msgid "timeout"
msgstr "тайм-аут"


### clockdiff options

msgid "by default, ICMP timestamps are only used (see RFC792, page 16)"
msgstr "за замовчуванням використовуються лише мітки часу ICMP (див. RFC792 ст.16)"

msgid "use IP timestamp and ICMP echo"
msgstr "використовувати мітки часу IP та ICMP echo"

msgid "use three-term IP timestamp and ICMP echo"
msgstr "використовувати трикомпонентні мітки часу IP та ICMP echo"

msgid "by default, 'ctime' format is used"
msgstr "за замовчуванням використовується формат часу ctime"

msgid "use ISO time format"
msgstr "використовувати формат часу ISO"


### ping options

msgid "use audible ping"
msgstr "використовувати звуковий супровід"

msgid "use adaptive ping"
msgstr "адаптивне зондування"

msgid "sticky source address"
msgstr "закріплена початкова адреса"

msgid "stop after 'count' replies"
msgstr "надіслати задану кількість ICMP запитів"

msgid "call connect() syscall on socket creation"
msgstr "скористатися викликом connect() при створенні сокета"

msgid "use SO_DEBUG socket option"
msgstr "встановити SO_DEBUG параметр сокета"

msgid "print timestamps"
msgstr "виводити часові позначки"

msgid "define ident for ping session,"
msgstr "визначити ідентифікатор ICMP пакетів,"

msgid "default is random for SOCK_RAW and kernel defined for SOCK_DGRAM,"
msgstr "випадковий для SOCK_RAW і визначається ядром для SOCK_DGRAM,"

msgid "imply using SOCK_RAW (for IPv4 only for ident 0)"
msgstr "передбачає використання SOCK_RAW (IPv4 тільки з ідент 0)"

msgid "flood ping"
msgstr "надсилати пакети якнайшвидше, тобто флуд"

msgid "force reverse DNS name resolution, override -n"
msgstr "примусово запитувати назви IP адрес, пріоритетніше за -n"

msgid "(useful for numeric destinations or for -f)"
msgstr "(корисно для числових адрес або з -f)"

msgid "seconds between sending each packet"
msgstr "інтервал між надсиланням пакетів у секундах"

msgid "either interface name or address"
msgstr "назва або адреса мережевого інтерфейсу"

msgid "send 'preload' number of packages while waiting replies"
msgstr "надіслати задану кількість пакетів під час очікування на відповідь"

msgid "suppress loopback of multicast packets"
msgstr "не використовувати петльовий інтерфейс для групової розсилки"

msgid "tag the packets going out"
msgstr "позначка для вихідних пакетів"

msgid "define path MTU discovery, can be one of do|dont|want|probe"
msgstr "визначити MTU режим, одне зі значень do|dont|want|probe"

msgid "no reverse DNS name resolution, override -H"
msgstr "не запитувати назви IP адрес"

msgid "report outstanding replies"
msgstr "звітувати нестандартні відповіді"

msgid "content of padding bytes"
msgstr "зразок для заповнення вихідних пакетів"

msgid "quality of service bits (ToS IPv4, TClass IPv6)"
msgstr "біти якості обслуговування (ToS IPv4, TClass IPv6)"

msgid "payload size"
msgstr "розмір даних поза заголовками"

msgid "use 'size' as SO_SNDBUF socket option value"
msgstr "використовувати 'розмір' як значення сокет параметра SO_SNDBUF"

msgid "define 'ttl' (time to live)"
msgstr "максимальне значення TTL (кількість переходів до пункту призначення)"

msgid "print user-to-user latency"
msgstr "виводити програмну затримку замість мережевої"

msgid "reply wait 'deadline' in seconds"
msgstr "'дедлайн' очікування на відповідь (у секундах)"

msgid "time to wait for response"
msgstr "час очікування на відповідь (у секундах)"

msgid "IPv4 options"
msgstr "Опції IPv4"

msgid "allow broadcast pings"
msgstr "дозволити пінгування всієї підмережі"

msgid "record route"
msgstr "запис маршруту"

msgid "define timestamp, can be one of TSONLY|TSANDADDR|TSPRESPEC"
msgstr "визначити часову позначку, одне зі значень TSONLY|TSANDADDR|TSPRESPEC"

msgid "IPv6 options"
msgstr "Опції IPv6"

msgid "define flow label, default is random"
msgstr "визначити відмітку потоку, типово то випадкова"

msgid "use IPv6 node info query, try '-N help', details in ping(8)"
msgstr "задати параметр IPv6 NodeInfo, подивіться '-N help', подробиці в ping(8)"

